    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
